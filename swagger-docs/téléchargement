        readOnly: true
      care_name:
        title: Care name
        type: string
        minLength: 1
      patient_observation:
        title: Patient observation
        type: string
        minLength: 1
      record_date:
        title: Record date
        type: string
        format: date-time
      consultation:
        title: Consultation
        type: integer
      nurse:
        title: Nurse
        type: integer
  Consultation:
    required:
    - consultation_summary
    - examination_required
    - hospital
    - dpi
    - doctor
    type: object
    properties:
      id:
        title: Id
        type: integer
        readOnly: true
      biological_exams:
        type: array
        items:
          $ref: '#/definitions/BiologicalExam'
        readOnly: true
      radiological_exams:
        type: array
        items:
          $ref: '#/definitions/RadiologicalExam'
        readOnly: true
      nursing_records:
