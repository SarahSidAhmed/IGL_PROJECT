        type: string
        minLength: 1
      hospital:
        title: Hospital
        type: string
        minLength: 1
      consultation_date:
        title: Consultation date
        type: string
        format: date-time
      dpi:
        title: Dpi
        type: integer
      doctor:
        title: Doctor
        type: integer
  Dpi:
    required:
    - password
    - social_security_number
    - first_name
    - last_name
    - birthdate
    - address
    - phone
    - emergency_contact_name
    - emergency_contact_phone
    - emergency_contact_relationship
    - gender
    - blood_type
    - mutuelle_name
    - mutuelle_policy_number
    - hospital
