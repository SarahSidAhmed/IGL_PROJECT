definitions:
  BiologicalExam:
    required:
    - exam_name
    - result
    - exam_date
    - consultation
    - lab_technician
    type: object
    properties:
      id:
        title: Id
        type: integer
        readOnly: true
      exam_name:
        title: Exam name
        type: string
        maxLength: 100
        minLength: 1
      result:
        title: Result
        type: string
        minLength: 1
      has_graph:
